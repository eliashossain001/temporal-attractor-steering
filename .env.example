# Copy this file to `.env` and fill in your values.
# `.env` is gitignored; never commit your real token.

# Hugging Face access token: https://huggingface.co/settings/tokens
# A "read" scope is sufficient for downloading public + gated public models.
#
# Several model families in configs/models.yaml are gated and require you to
# first accept the model's terms on the HF Hub page before downloading:
#   * meta-llama/Llama-3.2-*  and  meta-llama/Llama-3.1-*
#   * mistralai/Mistral-7B-v0.3
#   * google/gemma-2-*
# Pythia and Qwen-2.5 are open and need no prior approval.
HF_TOKEN=

# Optional: redirect the HF cache to a local folder
# (default is ~/.cache/huggingface). Useful on shared servers where the home
# directory has limited space, or to share a cache across users.
# HF_HOME=/path/to/large/disk/huggingface

# Optional: pin which GPU(s) the run uses. If unset, accelerate uses all
# visible CUDA devices. Example: CUDA_VISIBLE_DEVICES=0
# CUDA_VISIBLE_DEVICES=
